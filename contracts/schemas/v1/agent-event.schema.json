{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bi-agent.dev/contracts/v1/agent-event.schema.json",
  "title": "AgentEvent v1",
  "type": "object",
  "oneOf": [
    { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["event_type", "payload"], "properties": { "event_type": { "const": "status" }, "payload": { "$ref": "#/$defs/statusPayload" } } }] },
    { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["event_type", "payload"], "properties": { "event_type": { "const": "clarification" }, "payload": { "$ref": "#/$defs/clarificationPayload" } } }] },
    { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["event_type", "payload"], "properties": { "event_type": { "const": "semantic_query" }, "payload": { "$ref": "https://bi-agent.dev/contracts/v1/semantic-query.schema.json" } } }] },
    { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["event_type", "payload"], "properties": { "event_type": { "const": "sql" }, "payload": { "$ref": "#/$defs/sqlPayload" } } }] },
    { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["event_type", "payload"], "properties": { "event_type": { "const": "data" }, "payload": { "$ref": "https://bi-agent.dev/contracts/v1/query-result.schema.json" } } }] },
    { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["event_type", "payload"], "properties": { "event_type": { "const": "verified_facts" }, "payload": { "$ref": "https://bi-agent.dev/contracts/v1/verified-facts.schema.json" } } }] },
    { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["event_type", "payload"], "properties": { "event_type": { "const": "chart" }, "payload": { "$ref": "https://bi-agent.dev/contracts/v1/chart-intent.schema.json" } } }] },
    { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["event_type", "payload"], "properties": { "event_type": { "const": "insight" }, "payload": { "$ref": "#/$defs/insightPayload" } } }] },
    { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["event_type", "payload"], "properties": { "event_type": { "const": "warning" }, "payload": { "$ref": "#/$defs/warningPayload" } } }] },
    { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["event_type", "payload"], "properties": { "event_type": { "const": "error" }, "payload": { "$ref": "https://bi-agent.dev/contracts/v1/structured-error.schema.json" } } }] }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "eventBase": {
      "type": "object",
      "required": ["run_id", "sequence", "occurred_at"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    },
    "statusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "label"],
      "properties": {
        "status": { "type": "string", "enum": ["queued", "running", "awaiting_clarification", "completed", "empty", "rejected", "failed", "cancelled", "recovering"] },
        "label": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      }
    },
    "clarificationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "description"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "sqlPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialect", "statement"],
      "properties": {
        "dialect": { "enum": ["postgresql", "duckdb"] },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "insightPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidence"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "limitation": { "type": "string" }
      }
    },
    "warningPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
